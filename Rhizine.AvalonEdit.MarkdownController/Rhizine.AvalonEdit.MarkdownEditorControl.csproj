<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
	<PropertyGroup>
		<PackageId>Rhizine.AvalonEdit.MarkdownEditorControl</PackageId>
		<Version>1.0.0</Version>
		<Authors>Dillion Lowry</Authors>
		<Description>A Markdown editor control for AvalonEdit's TextEditor.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>wpf;markdown;editor</PackageTags>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="AssemblyInfo.cs" />
	</ItemGroup>
	<ItemGroup>
	  <None Remove="README.md" />
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Include="README.md">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </EmbeddedResource>
	</ItemGroup>
	
	<ItemGroup>
	  <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
	  <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.19" />
	</ItemGroup>
</Project>
